{% import "macros.html" as macros -%}
{% set section_path = feed_url | trim_start_matches(pat=config.base_url) | trim_end_matches(pat="feed.xml") -%}
{% set section = get_section(path=section_path ~ "_index.md") -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
    <generator uri="{{ config.base_url }}/{{ section.path | safe }}" version="0.1.0">{{ section.title }}</generator>
    <link href="{{ config.base_url }}/{{ section.path | safe }}feed.xml" rel="self" type="application/atom+xml" />
    <link href="{{ config.base_url }}/{{ section.path | safe }}" rel="alternate" type="text/html" />
    <id>{{ config.base_url}}/{{ section.path | safe }}</id>
    <title>{{ section.title }}</title>
    <subtitle>{{ section.description }}</subtitle>
    <author>
        <name>Maintained by {{ config.author }}.</name>
        <uri>{{ config.base_url }}/</uri>
    </author>
    <updated>{{ now() | date(format="%Y-%m-%dT%H:%M:%S+00:00") }}</updated>

    {% for page in section.pages | reverse %}
    <entry>
        <title>{{ page.title | safe }}</title>
        <link rel="alternate" href="{{ config.base_url }}/{{ page.path | safe }}" type="text/html" title="{{ page.title | safe }}" />
        {%- set num_comps = page.components | length %}
        {%- set page_path = page.components | join(sep="/") %}
        {%- if num_comps < 4 %}{{ throw(message="Missing date in 'path' key, required format: 'YYYY/MM/DD/slug-of-your-choice' got " ~ page_path) }}{% endif %}
        {%- set year = page.components | nth(n=num_comps - 4) %}
        {%- set month = page.components | nth(n=num_comps - 3) %}
        {%- set day = page.components | nth(n=num_comps - 2) %}
        <published>{{ page.date | date(format="%Y-%m-%d") }}T00:00:00+00:00</published>
        {% if "updated" in page.extra %}
        <updated>{{ page.extra.updated | date(format="%Y-%m-%d") }}T00:00:00+00:00</updated>
        {% endif %}
        <id>{{ config.base_url }}/{{ page.path | safe }}</id>
        <content type="html" xml:base="{{ config.base_url }}{{ page.path | safe }}">{{ page.content }}</content>

        <author>
            <name>{{ page.authors | join(sep=", ") }}</name>
        </author>
    </entry>
    {%- if loop.index == 10 %}{% break %}{% endif %}
    {%- endfor %}
</feed>
